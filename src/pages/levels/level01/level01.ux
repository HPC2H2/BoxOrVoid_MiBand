<import name="game-grid" src="../../../components/GameGrid/index"></import>
<import name="control-button" src="../../../components/ControlButton/index"></import>

<template>
  <div class="container" style="padding: {{ adaptedSizes.paddingTop }}px {{ adaptedSizes.padding }}px {{ adaptedSizes.paddingBottom }}px">
    <image
      class="title"
      src="/common/image/title.png"
      style="width: {{ adaptedSizes.titleWidth }}px; height: {{ adaptedSizes.titleHeight }}px; margin: {{ adaptedSizes.marginTop }}px 0 3px 0"
    />

    <!-- 游戏信息 -->
    <div class="info">
      <image
        class="infoText"
        src="/common/image/infoText.png"
        style="height: {{ adaptedSizes.infoHeight || 40 }}px"
      />
      <image
        class="hint"
        src="/common/image/hint.png"
        style="height: {{ adaptedSizes.infoHeight || 40 }}px"
      />
    </div>

    <!-- 画布 -->
    <game-grid
      rows="{{ rows }}"
      columns="{{ columns }}"
      icons="{{ cellIcons }}"
      cell-styles="{{ cellStyles }}"
      size-config="{{ adaptedSizes }}"
    ></game-grid>

    <!-- 控制区域 -->
    <div class="controlArea" style="margin-top: {{ adaptedSizes.marginTop || 4 }}px">
      <div class="switchArea" style="margin-bottom: {{ adaptedSizes.marginBottom || 10 }}px">
        <div onclick="onSwitch">
          <control-button
            type="switch"
            color="{{ switchBtnColor }}"
            is-white="{{ currentPlayer === 7 }}"
            size-config="{{ adaptedSizes }}"
          ></control-button>
        </div>
      </div>

      <div class="controlPanel" style="margin: {{ adaptedSizes.controlPanelMargin || 4 }}px">
        <div class="btnRow1" style="margin-bottom: {{ adaptedSizes.btnRowMargin || 4 }}px">
          <div onclick="onUp">
            <control-button
              type="arrow"
              color="{{ upBtnColor }}"
              arrow-icon="/common/image/icons/white-up-arrow.png"
              size-config="{{ adaptedSizes }}"
            ></control-button>
          </div>
        </div>
        <div class="btnRow2">
          <div onclick="onLeft">
            <control-button
              type="arrow"
              color="{{ leftBtnColor }}"
              arrow-icon="/common/image/icons/white-left-arrow.png"
              size-config="{{ adaptedSizes }}"
            ></control-button>
          </div>
          <div onclick="onDown">
            <control-button
              type="arrow"
              color="{{ downBtnColor }}"
              arrow-icon="/common/image/icons/white-down-arrow.png"
              size-config="{{ adaptedSizes }}"
            ></control-button>
          </div>
          <div onclick="onRight">
            <control-button
              type="arrow"
              color="{{ rightBtnColor }}"
              arrow-icon="/common/image/icons/white-right-arrow.png"
              size-config="{{ adaptedSizes }}"
            ></control-button>
          </div>
        </div>
      </div>
    </div>

    <div class="controlArea2">
      <div class="undoArea">
        <div onclick="onUndo">
          <control-button
            type="undo"
            color="{{ undoBtnColor }}"
            size-config="{{ adaptedSizes }}"
          ></control-button>
        </div>
      </div>
      <div class="resetArea">
        <div onclick="onReset">
          <control-button
            type="reset"
            color="{{ resetBtnColor }}"
            size-config="{{ adaptedSizes }}"
          ></control-button>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import {Game} from "../../../game/index"
import router from "@system.router"
import device from "@system.device"
import prompt from "@system.prompt"
import {getAdaptedSizes} from "../../../common/screenAdapter"
import {GAME_CONSTANTS} from "../../../game/constants"

const BUTTON_COLORS = GAME_CONSTANTS.BUTTON_COLORS
const BUTTON_FEEDBACK = {
  up: [BUTTON_COLORS.DEFAULT_ARROW, BUTTON_COLORS.PRESSED_ARROW, 200],
  down: [BUTTON_COLORS.DEFAULT_ARROW, BUTTON_COLORS.PRESSED_ARROW, 200],
  left: [BUTTON_COLORS.DEFAULT_ARROW, BUTTON_COLORS.PRESSED_ARROW, 200],
  right: [BUTTON_COLORS.DEFAULT_ARROW, BUTTON_COLORS.PRESSED_ARROW, 200],
  switch: [BUTTON_COLORS.DEFAULT_SWITCH, BUTTON_COLORS.PRESSED_SWITCH, 500],
  reset: [BUTTON_COLORS.DEFAULT_RESET, BUTTON_COLORS.PRESSED_RESET, 500],
  undo: [BUTTON_COLORS.DEFAULT_UNDO, BUTTON_COLORS.PRESSED_UNDO, 200]
}

export default {
  private: {
    rows: [0, 1, 2, 3, 4, 5, 6],
    columns: [0, 1, 2, 3, 4],
    cellIcons: {},
    cellStyles: {},
    currentPlayer: 7,
    switchBtnColor: "#3498DB",
    upBtnColor: "#2ECC71",
    downBtnColor: "#2ECC71",
    leftBtnColor: "#2ECC71",
    rightBtnColor: "#2ECC71",
    resetBtnColor: "#E74C3C",
    undoBtnColor: "#9B59B6",
    // 适配尺寸
    adaptedSizes: getAdaptedSizes(192)
  },

  onInit() {
    this._destroyed = false
    this._leaving = false
    this._flashTimers = {}
    // 获取屏幕信息并计算适配尺寸
    this.initScreenAdapter()

    // 初始化游戏
    // 游戏状态和历史记录不参与模板的数据绑定。
    this._game = new Game()

    // 加载关卡数据
    const levelData = this.getLevel1Data()
    this._game.initLevel(levelData)

    // 更新UI
    this.updateDisplay()
  },

  initScreenAdapter() {
    // 同时使用屏幕宽高，避免较宽的手环把底部按钮放大到圆弧外。
    try {
      device.getInfo({
        success: (data) => {
          if (!this._destroyed) {
            this.adaptedSizes = getAdaptedSizes(data && data.screenWidth, data && data.screenHeight)
          }
        },
        fail: () => {
          // 使用默认 Mi Band 9 尺寸
          if (!this._destroyed) this.adaptedSizes = getAdaptedSizes(192)
        }
      })
    } catch (e) {
      // 使用默认 Mi Band 9 尺寸
      this.adaptedSizes = getAdaptedSizes(192)
    }
  },

  getLevel1Data() {
    return {
      whitePlayer: {x: 4, y: 1},
      blackPlayer: {x: 2, y: 3},
      whiteBoxes: [{x: 2, y: 6}],
      blackBoxes: [{x: 3, y: 4}],
      whiteBoxTargets: [{x: 1, y: 6}],
      blackBoxTargets: [{x: 3, y: 3}],
      whitePlayerTarget: [{x: 1, y: 5}],
      blackPlayerTarget: [{x: 4, y: 2}],
      currentPlayer: 7,
      mapRules: this.createMapRules()
    }
  },

  createMapRules() {
    const width = 5,
      height = 7
    const rules = {}

    // 1. 默认白地（0）
    for (let y = 0; y < height; y++) {
      for (let x = 0; x < width; x++) {
        rules[y + "," + x] = 0
      }
    }

    // 2. 四周黑墙(1)
    for (let x = 0; x < width; x++) {
      rules["0," + x] = 1
      rules[height - 1 + "," + x] = 1
    }
    for (let y = 0; y < height; y++) {
      rules[y + ",0"] = 1
      rules[y + "," + (width - 1)] = 1
    }

    // 3. 内部黑墙
    rules["1,2"] = 1
    rules["2,2"] = 1
    rules["1,4"] = 1
    rules["2,4"] = 1

    return rules
  },

  updateDisplay(display) {
    const result = display || this._game.updateCellDisplay()
    if (!this.cellIcons['0,0']) {
      this.cellIcons = result.icons
      this.cellStyles = result.styles
    } else {
      // 保留响应式对象，只修改发生变化的叶子属性。
      Object.keys(result.icons).forEach(key => {
        const icon = result.icons[key]
        const currentIcon = this.cellIcons[key]
        Object.keys(icon).forEach(field => {
          if (currentIcon[field] !== icon[field]) currentIcon[field] = icon[field]
        })
        const style = result.styles[key]
        const currentStyle = this.cellStyles[key]
        if (currentStyle.bg !== style.bg) currentStyle.bg = style.bg
        if (currentStyle.border !== style.border) currentStyle.border = style.border
      })
    }
    this.currentPlayer = this._game.state.currentPlayer
  },

  onUp() {
    this.handleMove(0, -1, "up")
  },

  onDown() {
    this.handleMove(0, 1, "down")
  },

  onLeft() {
    this.handleMove(-1, 0, "left")
  },

  onRight() {
    this.handleMove(1, 0, "right")
  },

  handleMove(dx, dy, buttonType) {
    if (this._leaving || this._destroyed) return
    const result = this._game.move(dx, dy)

    if (!result.success) {
      prompt.showToast({message: result.message, duration: 1500})
      return
    }

    // 按钮闪动效果
    this.flashButton(buttonType)

    // 更新UI
    this.updateDisplay(result.display)

    if (result.isWin) {
      this._leaving = true
      this.clearButtonFeedback()
      // 完成的棋盘不再留在页面栈里，重玩不会逐次堆积页面。
      router.replace({
        uri: "/pages/win",
        params: {
          levelId: "level01",
          levelPath: "/pages/levels/level01"
        }
      })
    }
  },

  onSwitch() {
    if (this._leaving || this._destroyed) return
    this.currentPlayer = this._game.switchPlayer()
    this.flashButton("switch")
  },

  onReset() {
    if (this._leaving || this._destroyed) return
    this.clearButtonFeedback()
    const levelData = this.getLevel1Data()
    this._game.initLevel(levelData)
    this.flashButton("reset")
    this.updateDisplay()
  },

  onUndo() {
    if (this._leaving || this._destroyed) return
    const result = this._game.undo()
    if (!result.success) {
      prompt.showToast({message: result.message, duration: 1500})
      return
    }
    this.flashButton("undo")
    this.updateDisplay()
  },

  flashButton(type) {
    const feedback = BUTTON_FEEDBACK[type]
    const colorKey = type + "BtnColor"
    this[colorKey] = feedback[1]
    if (this._flashTimers[type]) clearTimeout(this._flashTimers[type])
    this._flashTimers[type] = setTimeout(() => {
      this[colorKey] = feedback[0]
      delete this._flashTimers[type]
    }, feedback[2])
  },

  clearButtonFeedback() {
    Object.keys(this._flashTimers).forEach(type => {
      clearTimeout(this._flashTimers[type])
      this[type + "BtnColor"] = BUTTON_FEEDBACK[type][0]
    })
    this._flashTimers = {}
  },

  onHide() {
    this.clearButtonFeedback()
  },

  onDestroy() {
    this._destroyed = true
    this.clearButtonFeedback()
    this._game = null
  }
}
</script>

<style scoped>
.container {
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  background-color: #1a1a1a;
  padding: 28px 8px 32px;
  height: 100%;
  width: 100%;
}

.title {
  background-color: #1a1a1a;
  height: 28px;
  width: 120px;
  object-fit: fill;
  margin: 6px 0 3px 0;
}

.info {
  background-color: #ffffff;
  flex-direction: row;
  justify-content: flex-start;
  margin: 2px;
  border-radius: 6px;
  overflow: hidden;
}

.infoText {
  height: 40px;
  flex-direction: row;
  justify-content: flex-start;
  object-fit: fill;
  border-radius: inherit;
}

.hint {
  height: 40px;
  flex-direction: row;
  justify-content: flex-start;
  object-fit: fill;
  border-radius: inherit;
}

.controlArea {
  flex-direction: row;
  justify-content: center;
  width: 100%;
  margin-top: 4px;
}

.switchArea {
  margin-bottom: 10px;
}

.controlPanel {
  flex-direction: column;
  align-items: center;
  margin: 4px;
}

.btnRow1,
.btnRow2 {
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.btnRow1 {
  margin-bottom: 4px;
}

.controlArea2 {
  flex-direction: row;
  justify-content: center;
  width: 100%;
  margin-top: 4px;
}

.undoArea {
  align-items: center;
}

.resetArea {
  align-items: center;
}
</style>
