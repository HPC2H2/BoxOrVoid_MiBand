<import name="game-grid" src="../../../components/GameGrid/index"></import>
<import name="control-button" src="../../../components/ControlButton/index"></import>

<template>
  <div class="container" style="padding: {{ adaptedSizes.padding || 8 }}px">
    <image
      class="title"
      src="/common/image/title.png"
      style="height: {{ adaptedSizes.titleHeight || 30 }}px; margin: {{ adaptedSizes.marginTop || 6 }}px 0 3px 0"
    />

    <!-- 游戏信息 -->
    <div class="info">
      <image
        class="infoText"
        src="/common/image/infoText.png"
        style="height: {{ adaptedSizes.infoHeight || 40 }}px"
      />
      <image
        class="hint"
        src="/common/image/hint.png"
        style="height: {{ adaptedSizes.infoHeight || 40 }}px"
      />
    </div>

    <!-- 画布 -->
    <game-grid
      rows="{{ rows }}"
      columns="{{ columns }}"
      icons="{{ cellIcons }}"
      cell-styles="{{ cellStyles }}"
      size-config="{{ adaptedSizes }}"
    ></game-grid>

    <!-- 控制区域 -->
    <div class="controlArea" style="margin-top: {{ adaptedSizes.marginTop || 4 }}px">
      <div class="switchArea" style="margin-bottom: {{ adaptedSizes.marginBottom || 10 }}px">
        <div onclick="onSwitch">
          <control-button
            type="switch"
            color="{{ switchBtnColor }}"
            is-white="{{ currentPlayer === 7 }}"
            size-config="{{ adaptedSizes }}"
          ></control-button>
        </div>
      </div>

      <div class="controlPanel" style="margin: {{ adaptedSizes.controlPanelMargin || 4 }}px">
        <div class="btnRow1" style="margin-bottom: {{ adaptedSizes.btnRowMargin || 4 }}px">
          <div onclick="onUp">
            <control-button
              type="arrow"
              color="{{ upBtnColor }}"
              arrow-icon="/common/image/icons/white-up-arrow.png"
              size-config="{{ adaptedSizes }}"
            ></control-button>
          </div>
        </div>
        <div class="btnRow2">
          <div onclick="onLeft">
            <control-button
              type="arrow"
              color="{{ leftBtnColor }}"
              arrow-icon="/common/image/icons/white-left-arrow.png"
              size-config="{{ adaptedSizes }}"
            ></control-button>
          </div>
          <div onclick="onDown">
            <control-button
              type="arrow"
              color="{{ downBtnColor }}"
              arrow-icon="/common/image/icons/white-down-arrow.png"
              size-config="{{ adaptedSizes }}"
            ></control-button>
          </div>
          <div onclick="onRight">
            <control-button
              type="arrow"
              color="{{ rightBtnColor }}"
              arrow-icon="/common/image/icons/white-right-arrow.png"
              size-config="{{ adaptedSizes }}"
            ></control-button>
          </div>
        </div>
      </div>
    </div>

    <div class="controlArea2" style="gap: {{ adaptedSizes.controlAreaGap || 40 }}px">
      <div class="undoArea">
        <div onclick="onUndo">
          <control-button
            type="undo"
            color="{{ undoBtnColor }}"
            size-config="{{ adaptedSizes }}"
          ></control-button>
        </div>
      </div>
      <div class="resetArea">
        <div onclick="onReset">
          <control-button
            type="reset"
            color="{{ resetBtnColor }}"
            size-config="{{ adaptedSizes }}"
          ></control-button>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import {Game} from "../../../game/index"
import router from "@system.router"
import device from "@system.device"
import {getAdaptedSizes, getStyles} from "../../../common/screenAdapter"

export default {
  private: {
    game: null,
    rows: [0, 1, 2, 3, 4, 5, 6],
    columns: [0, 1, 2, 3, 4],
    cellIcons: {},
    cellStyles: {},
    stepCount: 0,
    currentPlayerName: "白方",
    currentPlayer: 7,
    switchBtnColor: "#3498DB",
    upBtnColor: "#2ECC71",
    downBtnColor: "#2ECC71",
    leftBtnColor: "#2ECC71",
    rightBtnColor: "#2ECC71",
    resetBtnColor: "#E74C3C",
    undoBtnColor: "#9B59B6",
    // 适配尺寸
    adaptedSizes: {},
    styles: {}
  },

  onInit() {
    // 获取屏幕信息并计算适配尺寸
    this.initScreenAdapter()

    // 初始化游戏
    this.game = new Game()

    // 加载关卡数据
    const levelData = this.getLevel1Data()
    this.game.initLevel(levelData)

    // 更新UI
    this.updateDisplay()
  },

  initScreenAdapter() {
    // 尝试获取设备屏幕宽度，如果失败则使用 Mi Band 9 默认值
    try {
      device.getInfo({
        success: (data) => {
          const screenWidth = data.width || 192
          this.adaptedSizes = getAdaptedSizes(screenWidth)
          this.styles = getStyles(this.adaptedSizes)
        },
        fail: () => {
          // 使用默认 Mi Band 9 尺寸
          this.adaptedSizes = getAdaptedSizes(192)
          this.styles = getStyles(this.adaptedSizes)
        }
      })
    } catch (e) {
      // 使用默认 Mi Band 9 尺寸
      this.adaptedSizes = getAdaptedSizes(192)
      this.styles = getStyles(this.adaptedSizes)
    }
  },

  getLevel1Data() {
    return {
      whitePlayer: {x: 4, y: 1},
      blackPlayer: {x: 2, y: 3},
      whiteBoxes: [{x: 2, y: 6}],
      blackBoxes: [{x: 3, y: 4}],
      whiteBoxTargets: [{x: 1, y: 6}],
      blackBoxTargets: [{x: 3, y: 3}],
      whitePlayerTarget: [{x: 1, y: 5}],
      blackPlayerTarget: [{x: 4, y: 2}],
      currentPlayer: 7,
      mapRules: this.createMapRules()
    }
  },

  createMapRules() {
    const width = 5,
      height = 7
    const rules = {}

    // 1. 默认白地（0）
    for (let y = 0; y < height; y++) {
      for (let x = 0; x < width; x++) {
        rules[y + "," + x] = 0
      }
    }

    // 2. 四周黑墙(1)
    for (let x = 0; x < width; x++) {
      rules["0," + x] = 1
      rules[height - 1 + "," + x] = 1
    }
    for (let y = 0; y < height; y++) {
      rules[y + ",0"] = 1
      rules[y + "," + (width - 1)] = 1
    }

    // 3. 内部黑墙
    rules["1,2"] = 1
    rules["2,2"] = 1
    rules["1,4"] = 1
    rules["2,4"] = 1

    return rules
  },

  updateDisplay() {
    this.cellIcons = this.game.iconManager.updateCellIcons()
    this.stepCount = this.game.state.stepCount
    this.currentPlayer = this.game.state.currentPlayer
    this.currentPlayerName = this.currentPlayer === 6 ? "白方" : "黑方"

    // 计算所有单元格样式
    const styles = {}
    for (let y = 0; y < 7; y++) {
      for (let x = 0; x < 5; x++) {
        styles[`${y},${x}`] = {
          bg: this.getCellBg(y, x),
          border: this.getCellBorder(y, x)
        }
      }
    }
    this.cellStyles = styles
  },

  onUp() {
    this.handleMove(0, -1, "up")
  },

  onDown() {
    this.handleMove(0, 1, "down")
  },

  onLeft() {
    this.handleMove(-1, 0, "left")
  },

  onRight() {
    this.handleMove(1, 0, "right")
  },

  handleMove(dx, dy, buttonType) {
    const result = this.game.move(dx, dy)

    if (!result.success) {
      prompt.showToast({message: result.message, duration: 800})
      return
    }

    // 按钮闪动效果
    this.flashButton(buttonType)

    // 更新UI
    this.updateDisplay()

    // test 跳转
    // if (1){
    // 检查通关
    if (this.game.checkWin()) {
      // 跳转到通关页面
      router.push({
        uri: "pages/win",
        params: {
          levelId: "level01",
          levelPath: "pages/levels/level01"
        }
      })
    }
  },

  onSwitch() {
    this.game.switchPlayer()
    this.flashButton("switch")
    this.updateDisplay()
  },

  onReset() {
    const levelData = this.getLevel1Data()
    this.game.initLevel(levelData)
    this.flashButton("reset")
    this.updateDisplay()
  },

  onUndo() {
    const result = this.game.undo()
    if (!result.success) {
      prompt.showToast({message: result.message, duration: 800})
      return
    }
    this.flashButton("undo")
    this.updateDisplay()
  },

  flashButton(type) {
    const colorMap = {
      up: "#36D1DC",
      down: "#36D1DC",
      left: "#36D1DC",
      right: "#36D1DC",
      switch: "#FF416C",
      reset: "#FF6B6B",
      undo: "#8E44AD"
    }

    const defaultColorMap = {
      up: "#2ECC71",
      down: "#2ECC71",
      left: "#2ECC71",
      right: "#2ECC71",
      switch: "#3498DB",
      reset: "#E74C3C",
      undo: "#9B59B6"
    }

    const colorKey = type + "BtnColor"
    this[colorKey] = colorMap[type]

    setTimeout(
      () => {
        this[colorKey] = defaultColorMap[type]
      },
      type === "switch" || type === "reset" ? 500 : 200
    )
  },

  getCellBg(y, x) {
    return this.game.getCellBg(y, x)
  },

  getCellBorder(y, x) {
    return this.game.getCellBorder(y, x)
  }
}
</script>

<style scoped>
.container {
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  background-color: #1a1a1a;
  padding: 8px;
  height: 100%;
  width: 100%;
}

.title {
  background-color: #1a1a1a;
  height: 30px;
  width: 70%;
  object-fit: fill;
  margin: 6px 0 3px 0;
}

.info {
  background-color: #ffffff;
  flex-direction: row;
  justify-content: flex-start;
  margin: 2px;
  border-radius: 6px;
  overflow: hidden;
}

.infoText {
  height: 40px;
  flex-direction: row;
  justify-content: flex-start;
  object-fit: fill;
  border-radius: inherit;
}

.hint {
  height: 40px;
  flex-direction: row;
  justify-content: flex-start;
  object-fit: fill;
  border-radius: inherit;
}

.controlArea {
  flex-direction: row;
  width: 100%;
  margin-top: 4px;
}

.switchArea {
  margin-bottom: 10px;
}

.controlPanel {
  flex-direction: column;
  align-items: center;
  margin: 4px;
}

.btnRow1,
.btnRow2 {
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.btnRow1 {
  margin-bottom: 4px;
}

.controlArea2 {
  flex-direction: row;
  justify-content: center;
  width: 100%;
  margin-top: 4px;
  gap: 40px;
}

.undoArea {
  align-items: center;
}

.resetArea {
  align-items: center;
}
</style>
