  font-weight: bold;
  margin-bottom: 12px;
}

.message {
  font-size: 14px;
  color: #cccccc;
  margin-bottom: 12px;
  text-align: center;
  lines: 2;
}

.buttons {
  flex-direction: column;
  align-items: center;
}

