  font-size: 18px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 12px;
}

.message {
  font-size: 14px;
  color: #cccccc;
  margin-bottom: 12px;
  text-align: center;
  lines: 2;
}

.buttons {
  flex-direction: column;
  align-items: center;
}

.level-info {
  font-size: 12px;
  color: #cccccc;
  margin-bottom: 20px;
}

.button {
  flex-direction: row;
  min-width: 70px;
  height: 40px;
  border-radius: 8px;
  align-items: center;
  justify-content: center;
  padding: 0 16px;
  margin: 0 8px;
}

.button-glyph {
  object-fit: contain;
  width: 16px;
  height: 16px;
}

.restart-btn {
  background-color: #ff416c;
}
.select-btn {
  background-color: #3498DB;
  margin-top: 10px;
}
</style>
