<template>
  <div class="container">
    <text class="title">恭喜通关！</text>
    <text class="message">所有目标均已完成</text>
    <text class="level-info">当前版本共 1 关</text>
    
    <div class="buttons">
      <div class="button restart-btn" onclick="restartLevel">
        <text class="button-text">重玩</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

const LEVEL_PATH = '/pages/levels/level01'

export default {
  protected: {
    levelId: 'level01',
    levelPath: LEVEL_PATH,
  },

  onInit() {
    // 只接受当前已注册的关卡路由，同时兼容不带前导斜杠的参数。
    const path = '/' + String(this.levelPath || '').replace(/^\/+/, '')
    this.levelPath = path === LEVEL_PATH ? path : LEVEL_PATH
    this._leaving = false
  },

  onBackPress() {
    // 拦截返回键
    this.restartLevel()
    return true
  },
  
  restartLevel() {
    if (this._leaving) return
    this._leaving = true
    router.replace({
      uri: this.levelPath
    })
  }

  
}
</script>

